# Scan pipeline outputs — regenerated by scan_all.sh every run.
# Keeping these in git would produce large, noisy diffs.
**/.vscode/ext-static-analysis/cache/
**/.vscode/ext-static-analysis/callstacks.json
**/.vscode/ext-static-analysis/decorations.json
**/.vscode/ext-static-analysis/functions_html.json
**/.vscode/ext-static-analysis/scope_summaries_html.json
**/.vscode/ext-static-analysis/graphs/inheritance_graph.json
**/.vscode/ext-static-analysis/copilot_ctx.txt
**/.vscode/ext-static-analysis/_updated_data.state
**/.vscode/ext-detectors/

# Per-project scan artifacts.
**/semgrep.json
**/grep-output.txt
**/error_log.txt

# Scope-check harness output.
/scope_manifest.json

# Build caches.
**/target/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/*.pyc

# Editor scratch.
.DS_Store
*.swp
