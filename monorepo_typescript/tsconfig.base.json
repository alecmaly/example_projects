{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@mono/shared": ["packages/shared/src/index.ts"],
      "@mono/shared/*": ["packages/shared/src/*"],
      "@mono/utils": ["packages/utils/src/index.ts"],
      "@mono/utils/*": ["packages/utils/src/*"]
    }
  }
}
