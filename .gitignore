# Scan pipeline outputs — regenerated by scan_all.sh every run.
# Keeping these in git would produce large, noisy diffs. Everything
# under ext-static-analysis/ is derived from the source tree by the
# extractor + callstack builder + SQLite export; never hand-written.
**/.vscode/ext-static-analysis/cache/
**/.vscode/ext-static-analysis/graphs/
**/.vscode/ext-static-analysis/callstacks.html
**/.vscode/ext-static-analysis/callstacks.json
**/.vscode/ext-static-analysis/class_inheritance.json
**/.vscode/ext-static-analysis/copilot_ctx.txt
**/.vscode/ext-static-analysis/decorations.json
**/.vscode/ext-static-analysis/errors.json
**/.vscode/ext-static-analysis/func_call_edge_colors.json
**/.vscode/ext-static-analysis/func_state_var_read_written_mapping.json
**/.vscode/ext-static-analysis/function_calls.json
**/.vscode/ext-static-analysis/functions_html.json
**/.vscode/ext-static-analysis/help.html
**/.vscode/ext-static-analysis/inheritance_graph_inscope.json
**/.vscode/ext-static-analysis/scope_summaries_html.json
**/.vscode/ext-static-analysis/search_templates.json
**/.vscode/ext-static-analysis/seen_files.json
**/.vscode/ext-static-analysis/seen_files_for_refs.gzip
**/.vscode/ext-static-analysis/settings.json
**/.vscode/ext-static-analysis/source_import_tuples.json
**/.vscode/ext-static-analysis/static-analysis-context.db
**/.vscode/ext-static-analysis/static-analysis-context.db-shm
**/.vscode/ext-static-analysis/static-analysis-context.db-wal
**/.vscode/ext-static-analysis/var_ref_map.gzip
**/.vscode/ext-static-analysis/var_ref_map.json
**/.vscode/ext-static-analysis/vscode_static_analsysis_settings.json
**/.vscode/ext-static-analysis/_updated_data.state
**/.vscode/ext-detectors/

# Per-project scan artifacts.
**/semgrep.json
**/grep-output.txt
**/error_log.txt

# Scope-check harness output.
/scope_manifest.json

# Build caches.
**/target/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/*.pyc

# Editor scratch.
.DS_Store
*.swp
